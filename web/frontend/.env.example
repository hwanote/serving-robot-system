# 복사해서 .env.local 로 사용 (git 에 커밋되지 않음)

# mock: MSW Mock 서버 사용 (기본) / real: 실제 Backend 연결
VITE_API_MODE=mock

# 매장 ID / 상단 표시 이름
VITE_STORE_ID=demo_store
VITE_STORE_NAME=데모 매장

# real 모드에서 dev 서버가 /api, /ws 를 프록시할 Backend 주소
VITE_BACKEND_URL=http://localhost:8000

# (선택) 프록시 없이 직접 호출할 때만 지정. 비우면 같은 origin 사용
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws/state
