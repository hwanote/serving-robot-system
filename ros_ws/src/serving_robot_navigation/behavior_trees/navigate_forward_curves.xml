<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="Navigation">
      <Fallback name="CurvatureOrGridController">
        <Sequence name="ForwardCurve">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="ForwardPath"/>
          <FollowPath path="{path}" controller_id="ForwardController"/>
        </Sequence>
        <Sequence name="GridWithMPPI">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </Sequence>
      </Fallback>
      <Sequence name="RefreshSensorsAndWait">
        <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
        <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        <Wait wait_duration="2.0"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
