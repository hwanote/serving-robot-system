    <!-- ======================================================= -->
    <!-- Fixed decorations                                        -->
    <!-- ======================================================= -->

    <model name="planter_north_east">

      <static>true</static>

      <pose>3.25 2.20 0 0 0 0</pose>

      <link name="planter_link">

        <collision name="collision">
          <pose>0 0 0.325 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.65</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 0.325 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.65</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.18 0.36 0.18 1</ambient>
            <diffuse>0.22 0.48 0.22 1</diffuse>
          </material>
