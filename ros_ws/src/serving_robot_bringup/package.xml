<?xml version="1.0"?>
<package format="3">

  <name>serving_robot_bringup</name>
  <version>0.1.0</version>

  <description>
    Top-level bringup launch package for mapping, operation,
    and multi-robot execution modes.
  </description>

  <maintainer email="notihwan08@gmail.com">hwanote</maintainer>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
