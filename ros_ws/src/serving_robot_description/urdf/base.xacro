<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- Serving Robot Prototype Base                              -->
  <!--                                                           -->
  <!-- Coordinate convention                                     -->
  <!--   +X : forward                                             -->
  <!--   +Y : left                                                -->
  <!--   +Z : up                                                  -->
  <!--                                                           -->
  <!-- Drive configuration                                       -->
  <!--   Differential drive                                      -->
  <!--   Two independently driven wheels                         -->
  <!--   Front / rear passive caster supports                    -->
  <!-- ========================================================= -->


  <!-- ========================================================= -->
  <!-- Main dimensions                                            -->
  <!-- ========================================================= -->

  <xacro:property name="base_length" value="0.52"/>
  <xacro:property name="base_width" value="0.40"/>

  <!-- Height of base_link from ground -->
  <xacro:property name="base_link_z" value="0.12"/>

  <!-- Lower body skirt -->
  <xacro:property name="lower_shell_height" value="0.16"/>
  <xacro:property name="lower_shell_z" value="-0.02"/>

  <!-- Upper tapered-looking housing -->
  <xacro:property name="upper_shell_length" value="0.44"/>
  <xacro:property name="upper_shell_width" value="0.34"/>
  <xacro:property name="upper_shell_height" value="0.10"/>
  <xacro:property name="upper_shell_z" value="0.11"/>


  <!-- ========================================================= -->
  <!-- Drive wheels                                               -->
  <!-- ========================================================= -->

  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.035"/>

  <!--
    Wheels are intentionally placed inside the visual body shell.

    shell half width     = 0.200 m
    wheel center         = 0.175 m
    wheel outside edge   = 0.1925 m

    Therefore the wheels remain inside the visual envelope.
  -->
  <xacro:property name="wheel_separation" value="0.35"/>

  <!-- Measured in simulation: in-place rotation is about 10 percent larger than
       the 0.35 m geometric track predicts. Used only by DiffDrive (cmd and odom). -->
  <xacro:property name="wheel_separation_effective" value="0.316"/>

  <xacro:property
    name="wheel_z"
    value="${wheel_radius - base_link_z}"/>


  <!-- ========================================================= -->
  <!-- Passive support casters                                    -->
  <!-- ========================================================= -->

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_x" value="0.19"/>

  <xacro:property
    name="caster_z"
    value="${caster_radius - base_link_z + 0.003}"/>


  <!-- ========================================================= -->
  <!-- Mass                                                       -->
  <!-- ========================================================= -->

  <xacro:property name="base_mass" value="18.0"/>
  <xacro:property name="wheel_mass" value="0.7"/>
  <xacro:property name="caster_mass" value="0.2"/>


  <!-- ========================================================= -->
  <!-- Materials                                                  -->
  <!-- ========================================================= -->

  <material name="body_dark">
    <color rgba="0.12 0.14 0.16 1.0"/>
  </material>

  <material name="body_white">
    <color rgba="0.82 0.84 0.86 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>

  <material name="caster_dark">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- Inertia helpers                                            -->
  <!-- ========================================================= -->

  <xacro:macro
    name="box_inertial"
    params="mass x y z">

    <inertial>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}"/>

    </inertial>

  </xacro:macro>


  <!-- Cylinder axis is Y after visual/collision rotation -->
  <xacro:macro
    name="wheel_inertial"
    params="mass radius width">

    <inertial>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${mass * (3.0 * radius * radius + width * width) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * radius * radius / 2.0}"
        iyz="0.0"
        izz="${mass * (3.0 * radius * radius + width * width) / 12.0}"/>

    </inertial>

  </xacro:macro>


  <xacro:macro
    name="sphere_inertial"
    params="mass radius">

    <inertial>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia
        ixx="${0.4 * mass * radius * radius}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.4 * mass * radius * radius}"
        iyz="0.0"
        izz="${0.4 * mass * radius * radius}"/>

    </inertial>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- Main base macro                                            -->
  <!-- ========================================================= -->

  <xacro:macro name="serving_robot_base" params="">


    <!-- ======================================================= -->
    <!-- Ground reference                                        -->
    <!-- ======================================================= -->

    <link name="base_footprint"/>


    <!-- ======================================================= -->
    <!-- Main chassis                                             -->
    <!-- ======================================================= -->

    <link name="base_link">

      <!-- ===================================================== -->
      <!-- Visual: lower product-style outer shell               -->
      <!-- ===================================================== -->

      <visual name="lower_shell_visual">

        <origin
          xyz="0 0 ${lower_shell_z}"
          rpy="0 0 0"/>

        <geometry>
          <box
            size="${base_length}
                  ${base_width}
                  ${lower_shell_height}"/>
        </geometry>

        <material name="body_dark"/>

      </visual>


      <!-- ===================================================== -->
      <!-- Visual: upper housing                                  -->
      <!-- ===================================================== -->

      <visual name="upper_shell_visual">

        <origin
          xyz="0 0 ${upper_shell_z}"
          rpy="0 0 0"/>

        <geometry>
          <box
            size="${upper_shell_length}
                  ${upper_shell_width}
                  ${upper_shell_height}"/>
        </geometry>

        <material name="body_white"/>

      </visual>


      <!-- ===================================================== -->
      <!-- Collision model                                       -->
      <!--                                                       -->
      <!-- Central collision body is narrower than visual shell  -->
      <!-- so the drive wheels have physical clearance.          -->
      <!--                                                       -->
      <!-- Front/rear bumpers preserve most of the outer         -->
      <!-- physical footprint without intersecting the wheels.   -->
      <!-- ===================================================== -->

      <collision name="central_chassis_collision">

        <origin
          xyz="0 0 0.03"
          rpy="0 0 0"/>

        <geometry>
          <box size="0.40 0.30 0.18"/>
        </geometry>

      </collision>


      <collision name="front_bumper_collision">

        <origin
          xyz="0.22 0 -0.02"
          rpy="0 0 0"/>

        <geometry>
          <box size="0.08 0.38 0.10"/>
        </geometry>

      </collision>


      <collision name="rear_bumper_collision">

        <origin
          xyz="-0.22 0 -0.02"
          rpy="0 0 0"/>

        <geometry>
          <box size="0.08 0.38 0.10"/>
        </geometry>

      </collision>


      <!-- Approximate inertia using the whole base envelope -->

      <xacro:box_inertial
        mass="${base_mass}"
        x="${base_length}"
        y="${base_width}"
        z="${lower_shell_height + upper_shell_height}"/>

    </link>


    <!-- ======================================================= -->
    <!-- base_footprint -> base_link                             -->
    <!-- ======================================================= -->

    <joint name="base_footprint_joint" type="fixed">

      <parent link="base_footprint"/>
      <child link="base_link"/>

      <origin
        xyz="0 0 ${base_link_z}"
        rpy="0 0 0"/>

    </joint>


    <!-- ======================================================= -->
    <!-- Left drive wheel                                        -->
    <!-- ======================================================= -->

    <link name="left_wheel_link">

      <visual>

        <!--
          URDF cylinder axis is Z by default.
          Rotate 90 degrees around X so axle aligns with Y.
        -->

        <origin
          xyz="0 0 0"
          rpy="1.57079632679 0 0"/>

        <geometry>

          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

        </geometry>

        <material name="wheel_black"/>

      </visual>


      <collision>

        <origin
          xyz="0 0 0"
          rpy="1.57079632679 0 0"/>

        <geometry>

          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

        </geometry>

      </collision>


      <xacro:wheel_inertial
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        width="${wheel_width}"/>

    </link>


    <joint name="left_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="left_wheel_link"/>

      <origin
        xyz="0 ${wheel_separation / 2.0} ${wheel_z}"
        rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>


    <!-- ======================================================= -->
    <!-- Right drive wheel                                       -->
    <!-- ======================================================= -->

    <link name="right_wheel_link">

      <visual>

        <origin
          xyz="0 0 0"
          rpy="1.57079632679 0 0"/>

        <geometry>

          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

        </geometry>

        <material name="wheel_black"/>

      </visual>


      <collision>

        <origin
          xyz="0 0 0"
          rpy="1.57079632679 0 0"/>

        <geometry>

          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

        </geometry>

      </collision>


      <xacro:wheel_inertial
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        width="${wheel_width}"/>

    </link>


    <joint name="right_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="right_wheel_link"/>

      <origin
        xyz="0 ${-wheel_separation / 2.0} ${wheel_z}"
        rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>


    <!-- ======================================================= -->
    <!-- Front passive caster                                    -->
    <!-- ======================================================= -->

    <link name="front_caster_link">

      <visual>

        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>

        <material name="caster_dark"/>

      </visual>


      <collision>

        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>

      </collision>


      <xacro:sphere_inertial
        mass="${caster_mass}"
        radius="${caster_radius}"/>

    </link>


    <joint name="front_caster_joint" type="fixed">

      <parent link="base_link"/>
      <child link="front_caster_link"/>

      <origin
        xyz="${caster_x} 0 ${caster_z}"
        rpy="0 0 0"/>

    </joint>


    <!-- ======================================================= -->
    <!-- Rear passive caster                                     -->
    <!-- ======================================================= -->

    <link name="rear_caster_link">

      <visual>

        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>

        <material name="caster_dark"/>

      </visual>


      <collision>

        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>

      </collision>


      <xacro:sphere_inertial
        mass="${caster_mass}"
        radius="${caster_radius}"/>

    </link>


    <joint name="rear_caster_joint" type="fixed">

      <parent link="base_link"/>
      <child link="rear_caster_link"/>

      <origin
        xyz="${-caster_x} 0 ${caster_z}"
        rpy="0 0 0"/>

    </joint>


    <gazebo reference="left_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="right_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="front_caster_link">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>

    <gazebo reference="rear_caster_link">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>

    <gazebo>

      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <wheel_separation>${wheel_separation_effective}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>

        <odom_publish_frequency>50</odom_publish_frequency>

        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>

      </plugin>

      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">

        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>

      </plugin>

    </gazebo>

  </xacro:macro>

</robot>