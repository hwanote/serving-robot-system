<?xml version="1.0"?>

<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="serving_robot">

  <xacro:arg
    name="robot_name"
    default="robot_01"/>

  <xacro:include
    filename="$(find serving_robot_description)/urdf/base.xacro"/>

  <xacro:include
    filename="$(find serving_robot_description)/urdf/sensors.xacro"/>

  <xacro:serving_robot_base/>

  <xacro:serving_robot_sensors
    robot_name="$(arg robot_name)"/>

</robot>
